---
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import RepositoryLink from './HeaderRepositoryLink.astro';
---
<div class="brand-header">
  <div class="brand-brand"><SiteTitle /></div>
  <nav class="brand-header-controls" aria-label="Documentation search and SuperPlane links">
    <div class="brand-search"><Search /></div>
    <a class="brand-button brand-button--secondary brand-website" href="https://superplane.com/">Website</a>
    <a class="brand-button brand-header-app" href="https://app.superplane.com/">Open app</a>
  </nav>
  <div class="brand-desktop-repository"><RepositoryLink /></div>
  <button class="brand-more-button" popovertarget="brand-mobile-actions" aria-label="More actions" aria-haspopup="dialog">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="12" cy="19" r="1.7"/></svg>
  </button>
  <div id="brand-mobile-actions" popover="auto" role="dialog" aria-label="SuperPlane on GitHub">
    <RepositoryLink />
    <button class="brand-more-close" popovertarget="brand-mobile-actions" popovertargetaction="hide" aria-label="Close more actions">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg>
    </button>
  </div>
</div>
<script>
  const starCounts = document.querySelectorAll<HTMLElement>('.brand-repository-stars');
  if (starCounts.length) {
    fetch('https://api.github.com/repos/superplanehq/superplane', { credentials: 'omit' })
      .then(response => response.ok ? response.json() : null)
      .then(repository => {
        if (Number.isSafeInteger(repository?.stargazers_count)) {
          for (const stars of starCounts) {
            const count = stars.querySelector('[data-star-count]');
            if (count) count.textContent = new Intl.NumberFormat('en-US').format(repository.stargazers_count);
            stars.hidden = false;
          }
        }
      })
      .catch(() => { /* The repository link remains available when counts cannot load. */ });
  }
  const docsMenu = document.querySelector('starlight-menu-button');
  const docsMenuButton = docsMenu?.querySelector('button');
  if (docsMenu && docsMenuButton) {
    const updateLabel = () => docsMenuButton.setAttribute('aria-label', docsMenu.getAttribute('aria-expanded') === 'true' ? 'Close docs' : 'Browse docs');
    updateLabel();
    new MutationObserver(updateLabel).observe(docsMenu, { attributes: true, attributeFilter: ['aria-expanded'] });
  }
  const desktop = matchMedia('(min-width: 50rem)');
  desktop.addEventListener('change', () => {
    if (desktop.matches) document.querySelector<HTMLElement>('#brand-mobile-actions')?.hidePopover();
  });
</script>
