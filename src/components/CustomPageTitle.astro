---
import BrandArrowField from "./BrandArrowField.astro";
const { entry } = Astro.locals.starlightRoute;
const labels: Record<string,string> = {
  'get-started': 'Get started', fundamentals: 'Software factory fundamentals',
  'use-cases': 'Use cases', integrations: 'Integrations and components',
  components: 'Components', billing: 'Billing', 'open-source': 'Open source',
  troubleshooting: 'Support and help', 'release-notes': 'Release notes',
  expressions: 'Expressions', operate: 'Operate SuperPlane', security: 'Security', reference: 'Reference'
};
const section = entry.slug.split('/')[0];
const isIntro = entry.slug === 'get-started/overview';
---
<div class:list={['brand-title', { 'brand-title--intro': isIntro }]}>
  <p class="brand-eyebrow">{labels[section] ?? 'Documentation'} <span>/</span> {entry.data.title}</p>
  <h1 id="_top">{entry.data.title}</h1>
  <p class="brand-description">{entry.data.description}</p>
  <BrandArrowField />
</div>
