---
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{
		config.logo && logos.dark && (
			<>
				<img
					class:list={{ 'site-logo': true, 'light:sl-hidden print:hidden': !('src' in config.logo) }}
					alt={config.logo.alt}
					src={logos.dark.src}
					width={logos.dark.width}
					height={logos.dark.height}
				/>
				{!('src' in config.logo) && (
					<img
						class="site-logo dark:sl-hidden print:block"
						alt={config.logo.alt}
						src={logos.light?.src}
						width={logos.light?.width}
						height={logos.light?.height}
					/>
				)}
			</>
		)
	}
	<span class="site-title-text" translate="no">Docs</span>
	<span class="sr-only" translate="no">SuperPlane Factory Docs</span>
</a>

<style>
	@layer starlight.user {
		.site-title {
			align-items: center;
			gap: 16px;
			font-size: var(--sl-text-h4);
			font-weight: 500;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		.site-title-text {
			font-family: var(--sl-font-mono);
			font-size: 0.6875rem;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			color: #8fadb1;
			border-inline-start: 1px solid #303838;
			padding-inline-start: 16px;
		}
		span {
			overflow: hidden;
		}
		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 158px;
			margin-bottom: 0;
			object-fit: contain;
			object-position: 0 50%;
		}
		.site-title .site-logo {
			filter: none;
		}

		@media (max-width: 49.999rem) {
			.site-title {
				gap: 8px;
				max-width: 100%;
				overflow: hidden;
			}

			img {
				max-width: min(135px, 40vw);
			}

			.site-title-text {
				flex: 0 1 auto;
				font-size: 0.6875rem;
				text-overflow: ellipsis;
			}
		}

		@media (max-width: 24rem) {
			.site-title-text {
				display: none;
			}
		}
	}
</style>
