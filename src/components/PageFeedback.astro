<div class="page-feedback print:hidden" data-page-feedback>
  <p>Was this page helpful?</p>
  <div class="page-feedback__actions">
    <button type="button" data-feedback-value="yes" aria-label="Yes, this page was helpful" aria-pressed="false">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 10v11H3V10h4Zm2 11V9l4-7 2 1v6h5a2 2 0 0 1 2 2l-2 8a3 3 0 0 1-3 2H9Z" /></svg>
      Yes
    </button>
    <button type="button" data-feedback-value="no" aria-label="No, this page was not helpful" aria-pressed="false">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 14V3H3v11h4Zm2-11v12l4 7 2-1v-6h5a2 2 0 0 0 2-2l-2-8a3 3 0 0 0-3-2H9Z" /></svg>
      No
    </button>
  </div>
  <p class="page-feedback__thanks" aria-live="polite" hidden>Thank you for your feedback.</p>
</div>

<script>
  type PostHogWindow = Window & {
    posthog?: { capture: (event: string, properties: Record<string, string>) => void };
  };

  const initializeFeedback = () => {
    const feedback = document.querySelector<HTMLElement>("[data-page-feedback]");
    if (!feedback || feedback.dataset.feedbackBound === "true") return;
    feedback.dataset.feedbackBound = "true";

    const storageKey = `superplane-docs-feedback:${window.location.pathname}`;
    const buttons = feedback.querySelectorAll<HTMLButtonElement>("[data-feedback-value]");
    const thanks = feedback.querySelector<HTMLElement>(".page-feedback__thanks");

    const selectFeedback = (value: string, report = false) => {
      buttons.forEach((button) => {
        const selected = button.dataset.feedbackValue === value;
        button.classList.toggle("is-selected", selected);
        button.setAttribute("aria-pressed", String(selected));
      });

      if (thanks) thanks.hidden = false;
      try {
        window.localStorage.setItem(storageKey, value);
      } catch {
        // Feedback delivery does not depend on browser storage availability.
      }

      if (report) {
        (window as PostHogWindow).posthog?.capture("docs_page_feedback", {
          value,
          path: window.location.pathname,
          title: document.title,
        });
      }
    };

    let savedFeedback: string | null = null;
    try {
      savedFeedback = window.localStorage.getItem(storageKey);
    } catch {
      // Continue when storage is blocked by browser privacy settings.
    }
    if (savedFeedback) selectFeedback(savedFeedback);

    buttons.forEach((button) => {
      button.addEventListener("click", () => selectFeedback(button.dataset.feedbackValue ?? "", true));
    });
  };

  document.addEventListener("astro:page-load", initializeFeedback);
  initializeFeedback();
</script>

<style>
  @layer starlight.components {
    .page-feedback {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-block: 3rem 1.5rem;
      border-block: 1px solid var(--sl-color-hairline);
      padding-block: 1rem;
      color: var(--sl-color-gray-3);
    }

    .page-feedback > p:first-child {
      margin: 0 auto 0 0;
    }

    .page-feedback__actions {
      display: flex;
      gap: 0.75rem;
    }

    button {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 999px;
      padding: 0.45rem 1rem;
      color: var(--sl-color-gray-2);
      background: transparent;
      cursor: pointer;
    }

    button:hover,
    button.is-selected {
      border-color: var(--sl-color-text-accent);
      color: var(--sl-color-white);
      background: var(--sp-color-orange-wash);
    }

    svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.5;
    }

    .page-feedback__thanks {
      margin: 0;
      color: var(--sl-color-text-accent);
      font-size: var(--sl-text-sm);
    }

    @media (max-width: 30rem) {
      .page-feedback {
        align-items: flex-start;
        flex-wrap: wrap;
      }

      .page-feedback__thanks {
        width: 100%;
      }
    }
  }
</style>
